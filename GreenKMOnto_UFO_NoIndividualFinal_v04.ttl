###  http://www.semanticweb.org/tak/ontologies/2023/10/greenkmonto#UnitMember
:UnitMember rdf:type owl:NamedIndividual ,
                     gufo:Role .


#################################################################
#    Annotations
#################################################################

:UnitMember rdfs:comment "A person acting in an organisational role as a member of an organisational unit. This class represents the role semantics of a person within the organisation, capturing their formal position and responsibilities. The role semantics align with the UFO treatment of roles as relational properties."@en ;
            rdfs:label "Unit Member"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ProcessCore
                :ProcessInspective
                :ProcessManagerialAndPlanning
                :ProcessSupportive
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :WasteGenerationRate
                :WasteRecyclingRate
                :WasteToEnergyConservationRate
              )
] .


